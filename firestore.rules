rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomData(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
    function isMember(roomId) { return signedIn() && request.auth.uid in roomData(roomId).members; }

    // 닉네임 예약: 문서 ID = 소문자 닉네임, 먼저 만든 사람만 소유 (덮어쓰기 불가)
    match /names/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && key == request.resource.data.name.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // 내가 예약한 닉네임으로만 바꿀 수 있음
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 12
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid;
    }

    // 신고: 작성만 가능 (내용은 Firebase 콘솔에서 확인)
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter == request.auth.uid;
    }

    match /rooms/{roomId} {
      function pubCountOk() {
        return !('pubMembers' in request.resource.data)
          || request.resource.data.pubMembers == request.resource.data.members.size();
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
      allow update: if signedIn() && pubCountOk() && (
        // 방장: 강퇴(멤버 제거 + 재입장 금지), 공개/비공개 전환, 비밀번호
        (request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'banned', 'lastMessage', 'lastAt', 'pubAt', 'pubMembers', 'isPublic', 'pwHash']))
        ||
        // 누구나: 본인 입장/퇴장 + 마지막 메시지 갱신 (강퇴된 사람은 입장 불가)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastMessage', 'lastAt', 'pubAt', 'pubMembers'])
          && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
          && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members)
          && (request.auth.uid in resource.data.members || !(request.auth.uid in resource.data.get('banned', []))))
      );
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{msgId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.uid == request.auth.uid
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 500);
        // 신고: reportedBy 목록에 나만 추가 가능
        allow update: if isMember(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
          && request.resource.data.reportedBy.toSet().difference(resource.data.get('reportedBy', []).toSet()).hasOnly([request.auth.uid]);
      }

      match /games/{gameId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(roomId);
      }
    }
  }
}
